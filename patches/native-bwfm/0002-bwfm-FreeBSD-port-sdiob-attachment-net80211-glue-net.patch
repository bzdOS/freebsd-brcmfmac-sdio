+/*
+ * wpakey: WPA/WPA2-PSK for devices whose firmware runs the 4-way
+ * handshake (IEEE80211_IOC_WPAPSK), no wpa_supplicant needed:
+ *
+ *	ifconfig wlan0 ssid MyNet wpakey 'pass phrase' up
+ *
+ * The argument is an 8..63 character passphrase, or the PSK itself as
+ * 64 hex digits (optionally 0x-prefixed).  A passphrase is turned into
+ * the PSK here, PBKDF2-HMAC-SHA1(passphrase, ssid, 4096, 32) as in IEEE
+ * 802.11-2020 J.4.1, using the SSID in effect after all other arguments;
+ * the passphrase itself never reaches the kernel.
+ */
+static char wpakey_arg[66];
+static bool wpakey_registered;
+
+static void
+wpakey_hmac_sha1(const uint8_t *key, size_t keylen, const uint8_t *d1,
+    size_t l1, const uint8_t *d2, size_t l2, uint8_t out[SHA_DIGEST_LENGTH])
+{
+	SHA1_CTX ctx;
+	uint8_t k[64], pad[64];
+	int i;
+
+	memset(k, 0, sizeof(k));
+	if (keylen > sizeof(k)) {
+		SHA1_Init(&ctx);
+		SHA1_Update(&ctx, key, keylen);
+		SHA1_Final(k, &ctx);
+	} else
+		memcpy(k, key, keylen);
+	for (i = 0; i < 64; i++)
+		pad[i] = k[i] ^ 0x36;
+	SHA1_Init(&ctx);
+	SHA1_Update(&ctx, pad, sizeof(pad));
+	SHA1_Update(&ctx, d1, l1);
+	if (d2 != NULL)
+		SHA1_Update(&ctx, d2, l2);
+	SHA1_Final(out, &ctx);
+	for (i = 0; i < 64; i++)
+		pad[i] = k[i] ^ 0x5c;
+	SHA1_Init(&ctx);
+	SHA1_Update(&ctx, pad, sizeof(pad));
+	SHA1_Update(&ctx, out, SHA_DIGEST_LENGTH);
+	SHA1_Final(out, &ctx);
+	explicit_bzero(k, sizeof(k));
+	explicit_bzero(pad, sizeof(pad));
+}
+
+static void
+wpakey_pbkdf2(const char *pass, const uint8_t *ssid, size_t ssidlen,
+    uint8_t psk[32])
+{
+	uint8_t u[SHA_DIGEST_LENGTH], t[SHA_DIGEST_LENGTH], cnt[4];
+	size_t off, n;
+	int blk, i, j;
+
+	for (blk = 1, off = 0; off < 32; blk++, off += n) {
+		cnt[0] = blk >> 24;
+		cnt[1] = blk >> 16;
+		cnt[2] = blk >> 8;
+		cnt[3] = blk;
+		wpakey_hmac_sha1((const uint8_t *)pass, strlen(pass), ssid,
+		    ssidlen, cnt, sizeof(cnt), u);
+		memcpy(t, u, sizeof(t));
+		for (i = 1; i < 4096; i++) {
+			wpakey_hmac_sha1((const uint8_t *)pass, strlen(pass),
+			    u, sizeof(u), NULL, 0, u);
+			for (j = 0; j < SHA_DIGEST_LENGTH; j++)
+				t[j] ^= u[j];
+		}
+		n = MIN(sizeof(t), 32 - off);
+		memcpy(psk + off, t, n);
+	}
+	explicit_bzero(u, sizeof(u));
+	explicit_bzero(t, sizeof(t));
+}
+
+static bool
+wpakey_hex(const char *s, uint8_t psk[32])
+{
+	int i, hi, lo;
+
+	if (s[0] == '0' && tolower((u_char)s[1]) == 'x')
+		s += 2;
+	if (strlen(s) != 64)
+		return (false);
+	for (i = 0; i < 32; i++) {
+		hi = digittoint((u_char)s[2 * i]);
+		lo = digittoint((u_char)s[2 * i + 1]);
+		if (!isxdigit((u_char)s[2 * i]) ||
+		    !isxdigit((u_char)s[2 * i + 1]))
+			return (false);
+		psk[i] = (hi << 4) | lo;
+	}
+	return (true);
+}
+
+static void
+wpakey_cb(if_ctx *ctx, void *arg __unused)
+{
+	uint8_t ssid[IEEE80211_NWID_LEN], psk[32];
+	int ssidlen;
+
+	if (wpakey_arg[0] == '\0') {		/* -wpakey */
+		set80211(ctx, IEEE80211_IOC_WPAPSK, 0, 0, NULL);
+		set80211(ctx, IEEE80211_IOC_WPA, 0, 0, NULL);
+		set80211(ctx, IEEE80211_IOC_PRIVACY, 0, 0, NULL);
+		set80211(ctx, IEEE80211_IOC_AUTHMODE, IEEE80211_AUTH_OPEN,
+		    0, NULL);
+		return;
+	}
+	if (!wpakey_hex(wpakey_arg, psk)) {
+		if (get80211len(ctx, IEEE80211_IOC_SSID, ssid, sizeof(ssid),
+		    &ssidlen) < 0 || ssidlen == 0)
+			errx(1, "wpakey: set the ssid first (it salts the key)");
+		wpakey_pbkdf2(wpakey_arg, ssid, ssidlen, psk);
+	}
+	explicit_bzero(wpakey_arg, sizeof(wpakey_arg));
+	set80211(ctx, IEEE80211_IOC_AUTHMODE, IEEE80211_AUTH_WPA, 0, NULL);
+	set80211(ctx, IEEE80211_IOC_WPA, 3, 0, NULL);
+	set80211(ctx, IEEE80211_IOC_PRIVACY, 1, 0, NULL);
+	set80211(ctx, IEEE80211_IOC_WPAPSK, 0, sizeof(psk), psk);
+	explicit_bzero(psk, sizeof(psk));
+}
+
+static void
+set80211wpakey(if_ctx *ctx __unused, const char *val, int dummy __unused)
+{
+	uint8_t psk[32];
+	size_t len;
+
+	len = strlen(val);
+	if (!wpakey_hex(val, psk) && (len < 8 || len > 63))
+		errx(1, "wpakey: need an 8..63 character passphrase "
+		    "or 64 hex digits");
+	explicit_bzero(psk, sizeof(psk));
+	strlcpy(wpakey_arg, val, sizeof(wpakey_arg));
+	if (!wpakey_registered) {
+		callback_register(wpakey_cb, NULL);
+		wpakey_registered = true;
+	}
+}
+
+static void
+unset80211wpakey(if_ctx *ctx __unused, const char *val __unused,
+    int dummy __unused)
+{
+
+	wpakey_arg[0] = '\0';
+	if (!wpakey_registered) {
+		callback_register(wpakey_cb, NULL);
+		wpakey_registered = true;
+	}
+}
