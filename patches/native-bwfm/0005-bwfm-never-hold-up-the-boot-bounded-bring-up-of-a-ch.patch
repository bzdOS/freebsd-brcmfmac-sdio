+/*
+ * A warm reboot (or a guest restart) does not power-cycle the chip: the
+ * previous firmware may still be running, with F2 and card interrupts
+ * enabled, or the chip may be asleep (KSO cleared), in which case every
+ * backplane access times out.  Quiet the card and wake it before talking
+ * to the backplane; the ARM core is then halted by bwfm_chip_attach()
+ * (set_passive) before the new firmware is written to RAM.
+ */
 static void
-bwfm_sdio_attach_task(void *arg, int pending __unused)
+bwfm_sdio_quiesce(struct bwfm_sdio_softc *sc)
 {
-	struct bwfm_sdio_softc *sc = arg;
-	struct bwfm_softc *bwfm = &sc->sc_sc;
-	int i;
-
-	/* Firmware files live on the root file system. */
-	for (i = 0; rootvnode == NULL && i < 300; i++)
-		pause("bwfmroot", hz);
-	if (bwfm_sdio_preinit(bwfm) != 0 || bwfm_preinit(bwfm) != 0) {
-		device_printf(bwfm->sc_dev, "firmware start failed\n");
-		return;
+	sbintime_t deadline;
+	uint8_t v;
+	int tries;
+
+	(void) SDIO_WRITE_DIRECT(sc->sc_bus, 0, BWFM_SDIO_CCCR_INT_ENABLE, 0);
+	(void) sdio_disable_func(sc->sc_f2);
+
+	/* Keep SDIO On: write until the chip reports KSO and DEVON. */
+	deadline = getsbinuptime() + 2 * SBT_1S;
+	for (tries = 0; tries < 64; tries++) {
+		(void) SDIO_WRITE_DIRECT(sc->sc_bus, 1,
+		    BWFM_SDIO_FUNC1_SLEEPCSR, BWFM_SDIO_FUNC1_SLEEPCSR_KSO);
+		DELAY(100);
+		v = 0;
+		if (SDIO_READ_DIRECT(sc->sc_bus, 1, BWFM_SDIO_FUNC1_SLEEPCSR,
+		    &v) == 0 && (v & (BWFM_SDIO_FUNC1_SLEEPCSR_KSO |
+		    BWFM_SDIO_FUNC1_SLEEPCSR_DEVON)) ==
+		    (BWFM_SDIO_FUNC1_SLEEPCSR_KSO |
+		    BWFM_SDIO_FUNC1_SLEEPCSR_DEVON))
+			break;
+		if (getsbinuptime() > deadline)
+			break;
 	}
+	DPRINTF(("%s: KSO %#x after %d tries\n", DEVNAME(&sc->sc_sc), v,
+	    tries));
+	sc->sc_bus_err = 0;
 }
 
