+/*
+ * Everything that talks to the chip runs here, off the attach path, so a
+ * card that does not answer can never hold up the boot.  attach waits
+ * for it a bounded time (hw.bwfm.attach_wait) so that the com normally
+ * exists when kldload / rc.d kld return and rc.d/netif creates the vaps;
+ * if it finishes later, devd gets a WIFI ATTACH event instead (devd.conf
+ * runs "pccard_ether bwfmN startchildren" for it).
+ */
+static void
+bwfm_sdio_attach_task(void *arg, int pending __unused)
+{
+	struct bwfm_sdio_softc *sc = arg;
+	struct bwfm_softc *bwfm = &sc->sc_sc;
+	sbintime_t t0, t1, t2;
+	int error, i, late;
+
+	/* Firmware files live on the root file system. */
+	for (i = 0; rootvnode == NULL && i < 300; i++)
+		pause("bwfmroot", hz);
+
+	t0 = getsbinuptime();
+	error = bwfm_sdio_hw_attach(sc);
+	t1 = getsbinuptime();
+	if (error == 0 && bwfm_sdio_preinit(bwfm) != 0)
+		error = EIO;
+	t2 = getsbinuptime();
+	if (error == 0 && bwfm_preinit(bwfm) != 0)
+		error = EIO;
+	device_printf(bwfm->sc_dev, "bring-up: chip %d ms, firmware load %d "
+	    "ms, init %d ms\n", (int)((t1 - t0) / SBT_1MS),
+	    (int)((t2 - t1) / SBT_1MS),
+	    (int)((getsbinuptime() - t2) / SBT_1MS));
+	if (error != 0)
+		device_printf(bwfm->sc_dev, "WiFi not started%s\n",
+		    sc->sc_dead ? " (card not responding)" : "");
+
+	BWFM_LOCK(bwfm);
+	sc->sc_attach_state = error ? BWFM_SDIO_ATT_FAILED :
+	    BWFM_SDIO_ATT_DONE;
+	late = !sc->sc_attach_waiting;
+	wakeup(&sc->sc_attach_state);
+	BWFM_UNLOCK(bwfm);
+
+	if (error == 0 && late) {
+		device_printf(bwfm->sc_dev, "firmware up\n");
+		devctl_notify("WIFI", device_get_nameunit(bwfm->sc_dev),
+		    "ATTACH", NULL);
+	}
+}
+
+static int
+bwfm_sdio_attach(device_t dev)
+{
+	struct bwfm_sdio_softc *sc = device_get_softc(dev);
+	struct bwfm_softc *bwfm = &sc->sc_sc;
+	sbintime_t deadline, now;
+	int late;
+
+	bwfm->sc_dev = dev;
+	sc->sc_bus = device_get_parent(dev);
+	sc->sc_f1 = sdio_get_function(dev);
+	sc->sc_f2 = bwfm_sdio_sibling(dev, 2);
+	if (sc->sc_f1 == NULL || sc->sc_f2 == NULL) {
+		device_printf(dev, "SDIO function 2 not found\n");
+		return (ENXIO);
+	}
+
+	sx_init(&sc->sc_lock, "bwfm sdio");
+	mtx_init(&sc->sc_txq_mtx, "bwfm txq", NULL, MTX_DEF);
+	mbufq_init(&sc->sc_tx_queue, 1024);
+	sc->sc_bounce_size = 64 * 1024;
+	sc->sc_bounce_buf = contigmalloc(sc->sc_bounce_size, M_BWFM,
+	    M_WAITOK | M_ZERO, 0, ~(vm_paddr_t)0, PAGE_SIZE, 0);
+	sc->sc_tx_seq = 0xff;
+	sc->sc_tq = taskqueue_create("bwfm_sdio", M_WAITOK,
+	    taskqueue_thread_enqueue, &sc->sc_tq);
