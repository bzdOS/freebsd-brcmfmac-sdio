+/*
+ * Every bus access goes through bwfm_sdio_err().  A card that stopped
+ * answering (each failed command costs the sdiob timeout, seconds) must
+ * not be polled through the driver's register loops for minutes: after
+ * BWFM_SDIO_MAX_ERR failures in a row it is declared dead and further
+ * accesses fail at once.
+ */
+static int
+bwfm_sdio_err(struct bwfm_sdio_softc *sc, int error, const char *what,
+    uint32_t addr)
+{
+
+	if (error == 0) {
+		sc->sc_bus_err = 0;
+		return (0);
+	}
+	DPRINTF(("%s: %s %#x failed: %d\n", DEVNAME(&sc->sc_sc), what, addr,
+	    error));
+	if (++sc->sc_bus_err >= BWFM_SDIO_MAX_ERR && !sc->sc_dead) {
+		sc->sc_dead = 1;
+		device_printf(sc->sc_sc.sc_dev,
+		    "card not responding (%d bus errors in a row), giving up; "
+		    "WiFi stays down until the module is reloaded or the "
+		    "board is power-cycled\n", sc->sc_bus_err);
+	}
+	return (error);
+}
