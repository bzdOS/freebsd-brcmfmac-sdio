+/* Netgraph node methods */
+static ng_constructor_t	ngh4_constructor;
+static ng_rcvmsg_t		ngh4_rcvmsg;
+static ng_shutdown_t		ngh4_shutdown;
+static ng_newhook_t		ngh4_newhook;
+static ng_connect_t		ngh4_connect;
+static ng_rcvdata_t		ngh4_rcvdata;
+static ng_disconnect_t		ngh4_disconnect;
+
+#define	ERROUT(x)		do { error = (x); goto done; } while (0)
+
+/* ttyhook methods */
+static th_getc_inject_t	ngh4_getc_inject;
+static th_getc_poll_t		ngh4_getc_poll;
+static th_rint_t		ngh4_rint;
+static th_rint_bypass_t	ngh4_rint_bypass;
+static th_rint_poll_t		ngh4_rint_poll;
+
+static struct ttyhook ngh4_hook = {
+	.th_getc_inject = ngh4_getc_inject,
+	.th_getc_poll	= ngh4_getc_poll,
+	.th_rint	= ngh4_rint,
+	.th_rint_bypass	= ngh4_rint_bypass,
+	.th_rint_poll	= ngh4_rint_poll,
+};
+
+/* Netgraph node type descriptor */
+static struct ng_type typestruct = {
+	.version	= NG_ABI_VERSION,
+	.name		= NG_H4_NODE_TYPE,
+	.constructor	= ngh4_constructor,
+	.rcvmsg		= ngh4_rcvmsg,
+	.shutdown	= ngh4_shutdown,
+	.newhook	= ngh4_newhook,
+	.connect	= ngh4_connect,
+	.rcvdata	= ngh4_rcvdata,
+	.disconnect	= ngh4_disconnect,
+};
+NETGRAPH_INIT(h4, &typestruct);
+
+/******************************************************************
+			RX (tty -> HCI) FRAMING
+******************************************************************/
+
+/*
+ * Is "type" a legal H4 indicator byte for a frame arriving *from* the
+ * controller?  NG_HCI_CMD_PKT is deliberately excluded: this host never
+ * receives commands.
+ */
+static __inline int
+ngh4_rx_type_valid(uint8_t type)
+{
+
+	return (type == NG_HCI_ACL_DATA_PKT || type == NG_HCI_SCO_DATA_PKT ||
+	    type == NG_HCI_EVENT_PKT);
+}
+
+/*
+ * Fixed header length for "type", indicator byte included.  Only valid
+ * for the three types ngh4_rx_type_valid() accepts.
+ */
+static __inline uint8_t
+ngh4_hdrlen(uint8_t type)
+{
+
+	switch (type) {
+	case NG_HCI_ACL_DATA_PKT:
+		return (sizeof(ng_hci_acldata_pkt_t));
+	case NG_HCI_SCO_DATA_PKT:
+		return (sizeof(ng_hci_scodata_pkt_t));
+	case NG_HCI_EVENT_PKT:
+		return (sizeof(ng_hci_event_pkt_t));
+	default:
+		return (0);
+	}
+} /* ngh4_hdrlen */
+
+/*
+ * Payload length out of a just-completed header.  sc->rx_m's first mbuf
+ * is guaranteed to hold the whole header contiguously: we always give a
+ * fresh frame a full cluster (see ngh4_rx_newframe()), and the longest
+ * header (ACL, 5 bytes) is far smaller than MCLBYTES.
+ */
+static uint16_t
+ngh4_hdr_paylen(sc_p sc)
+{
+
+	switch (sc->rx_type) {
+	case NG_HCI_ACL_DATA_PKT:
+		return (le16toh(mtod(sc->rx_m,
+		    ng_hci_acldata_pkt_t *)->length));
+	case NG_HCI_SCO_DATA_PKT:
+		return (mtod(sc->rx_m, ng_hci_scodata_pkt_t *)->length);
+	case NG_HCI_EVENT_PKT:
+		return (mtod(sc->rx_m, ng_hci_event_pkt_t *)->length);
+	default:
+		return (0);
+	}
+} /* ngh4_hdr_paylen */
+
+/*
+ * Throw away whatever frame is in progress and go back to waiting for a
+ * fresh indicator byte.  tty context.
+ */
+static void
+ngh4_rx_abort(sc_p sc)
+{
+
+	if (sc->rx_m != NULL) {
+		m_freem(sc->rx_m);
+		sc->rx_m = sc->rx_last = NULL;
+	}
+	sc->rx_state = NGH4_ST_W4_PKT_TYPE;
+} /* ngh4_rx_abort */
+
+/*
+ * Start reassembling a new frame whose indicator byte is "type" (already
+ * validated by the caller).  Always allocates a full cluster up front --
+ * simpler and more robust than growing the very first mbuf byte by byte,
+ * and big enough that the (small) header is always contiguous.  Returns
+ * 0 on success, an errno on allocation failure (caller stays in
+ * NGH4_ST_W4_PKT_TYPE and drops the byte).
+ */
+static int
+ngh4_rx_newframe(sc_p sc, uint8_t type)
+{
+	struct mbuf *m;
+
+	MGETHDR(m, M_NOWAIT, MT_DATA);
+	if (m == NULL)
+		return (ENOBUFS);
+	if (!MCLGET(m, M_NOWAIT)) {
+		m_freem(m);
+		return (ENOBUFS);
+	}
+	m->m_pkthdr.rcvif = NULL;
+	m->m_len = m->m_pkthdr.len = 0;
+
+	sc->rx_m = sc->rx_last = m;
+	sc->rx_type = type;
+	sc->rx_hdrlen = ngh4_hdrlen(type);
+	sc->rx_need = 0;
+	sc->rx_state = NGH4_ST_W4_HDR;
+
+	*mtod(m, uint8_t *) = type;
+	m->m_len = m->m_pkthdr.len = 1;
+
+	return (0);
+} /* ngh4_rx_newframe */
+
+/*
+ * Append one byte to the frame being reassembled, growing the mbuf chain
+ * if the current tail is full.  Returns 0 on success, an errno on
+ * allocation failure (caller aborts the frame via ngh4_rx_abort()).
+ */
+static int
+ngh4_rx_putc(sc_p sc, uint8_t c)
+{
+	struct mbuf *m = sc->rx_last;
+
+	if (M_TRAILINGSPACE(m) == 0) {
+		struct mbuf *n;
+
+		MGET(n, M_NOWAIT, MT_DATA);
+		if (n == NULL)
+			return (ENOBUFS);
+		if (!MCLGET(n, M_NOWAIT)) {
+			m_free(n);
+			return (ENOBUFS);
+		}
+		n->m_len = 0;
+		m->m_next = n;
+		sc->rx_last = m = n;
+	}
+
+	*(mtod(m, uint8_t *) + m->m_len) = c;
+	m->m_len++;
+	sc->rx_m->m_pkthdr.len++;
+
+	return (0);
+} /* ngh4_rx_putc */
+
+/*
+ * A full frame has been reassembled in sc->rx_m: hand it to our peer (if
+ * any) and go back to waiting for the next indicator byte.  tty context;
+ * NG_SEND_DATA_ONLY() queues rather than calling straight through, same
+ * as ng_tty.c's ngt_rint() does from this same context.
+ */
+static void
+ngh4_rx_deliver(sc_p sc)
+{
+	struct mbuf *m = sc->rx_m;
+	int error;
+
+	sc->rx_m = sc->rx_last = NULL;
+	sc->rx_state = NGH4_ST_W4_PKT_TYPE;
+
+	NGH4_STAT_PCKTS_RECV(sc);
+	NGH4_STAT_BYTES_RECV(sc, m->m_pkthdr.len);
+
+	if (sc->hook == NULL) {
+		NG_FREE_M(m);
+		return;
+	}
+
+	NG_SEND_DATA_ONLY(error, sc->hook, m);
+	if (error != 0)
+		NGH4_STAT_IERROR(sc);
+} /* ngh4_rx_deliver */
+
+/*
+ * Feed one byte from the wire through the reassembly state machine.
+ * tty context, tty locked.
+ */
+static void
+ngh4_input(sc_p sc, uint8_t c)
+{
+
+	switch (sc->rx_state) {
+	case NGH4_ST_W4_PKT_TYPE:
+		if (!ngh4_rx_type_valid(c)) {
+			NGH4_STAT_IERROR(sc);
+			NGH4_INFO(sc, "unexpected byte 0x%02x while waiting "
+			    "for an H4 packet indicator, dropped\n", c);
+			break;
+		}
+		if (ngh4_rx_newframe(sc, c) != 0) {
+			NGH4_STAT_IERROR(sc);
+			NGH4_ERR(sc, "no mbufs, dropped indicator 0x%02x\n",
+			    c);
+			/* stays in NGH4_ST_W4_PKT_TYPE */
+		}
+		break;
+
+	case NGH4_ST_W4_HDR:
+		if (ngh4_rx_putc(sc, c) != 0) {
+			NGH4_STAT_IERROR(sc);
+			ngh4_rx_abort(sc);
+			break;
+		}
+		if ((uint8_t)sc->rx_m->m_pkthdr.len < sc->rx_hdrlen)
+			break;		/* still need more header bytes */
+
+		sc->rx_need = ngh4_hdr_paylen(sc);
+		if (sc->rx_need == 0)
+			ngh4_rx_deliver(sc);
+		else
+			sc->rx_state = NGH4_ST_W4_DATA;
+		break;
+
+	case NGH4_ST_W4_DATA:
+		if (ngh4_rx_putc(sc, c) != 0) {
+			NGH4_STAT_IERROR(sc);
+			ngh4_rx_abort(sc);
+			break;
+		}
+		sc->rx_need--;
+		if (sc->rx_need == 0)
+			ngh4_rx_deliver(sc);
+		break;
+
+	default:
+		panic("%s: bad rx_state %d", __func__, sc->rx_state);
+	}
+} /* ngh4_input */
+
+/******************************************************************
+			NETGRAPH NODE METHODS
+******************************************************************/
+
+/*
+ * A node may only be created explicitly (ngctl mkpeer/mknod); it starts
+ * out unbound to any tty until an NGM_H4_NODE_SET_TTY message arrives.
+ */
+static int
+ngh4_constructor(node_p node)
+{
+	sc_p sc;
+
+	sc = malloc(sizeof(*sc), M_NETGRAPH, M_WAITOK | M_ZERO);
+
+	NG_NODE_SET_PRIVATE(node, sc);
+	sc->node = node;
+	sc->rx_state = NGH4_ST_W4_PKT_TYPE;
+
+	mtx_init(&sc->outq.ifq_mtx, "ng_h4 node+queue", NULL, MTX_DEF);
+	IFQ_SET_MAXLEN(&sc->outq, ifqmaxlen);
+
+	return (0);
+} /* ngh4_constructor */
+
+/*
+ * There is exactly one hook, named NG_H4_HOOK ("hook"), normally
+ * connected to ng_hci(4)'s "drv" hook by the operator (ngctl).
+ */
+static int
+ngh4_newhook(node_p node, hook_p hook, const char *name)
+{
+	const sc_p sc = NG_NODE_PRIVATE(node);
+
+	if (strcmp(name, NG_H4_HOOK) != 0)
+		return (EINVAL);
+	if (sc->hook != NULL)
+		return (EISCONN);
+
+	NGH4LOCK(sc);
+	sc->hook = hook;
+	NGH4UNLOCK(sc);
+
+	return (0);
+} /* ngh4_newhook */
+
+/*
+ * Force our own hook into queuing mode so that frames arriving from
+ * ng_hci are delivered to ngh4_rcvdata() from the Netgraph queue-worker
+ * thread rather than synchronously from inside ng_hci's own call stack
+ * (which may be holding that node's WRITER lock) -- see the big comment
+ * at the top of this file.  Same as ng_tty.c's ngt_connect().
+ */
+static int
+ngh4_connect(hook_p hook)
+{
+
+	NG_HOOK_FORCE_QUEUE(hook);
+	return (0);
+} /* ngh4_connect */
+
+static int
+ngh4_disconnect(hook_p hook)
+{
+	const sc_p sc = NG_NODE_PRIVATE(NG_HOOK_NODE(hook));
+
+	if (hook != sc->hook)
+		panic("%s", __func__);
+
+	NGH4LOCK(sc);
+	sc->hook = NULL;
+	IF_DRAIN(&sc->outq);
+	sc->outqlen = 0;
+	NGH4UNLOCK(sc);
+
+	return (0);
+} /* ngh4_disconnect */
+
+/*
+ * Detach from the tty (if bound) and free everything.  No ng_h4 lock is
+ * held across ttyhook_unregister(): it wants the tty locked instead, and
+ * like ng_tty.c's ngt_shutdown(), we rely on it and tty_rel_free() to
+ * leave the tty unlocked.
+ */
+static int
+ngh4_shutdown(node_p node)
+{
+	const sc_p sc = NG_NODE_PRIVATE(node);
+	struct tty *tp;
+
+	tp = sc->tp;
+	if (tp != NULL) {
+		tty_lock(tp);
+		ttyhook_unregister(tp);
+	}
+
+	ngh4_rx_abort(sc);
+	IF_DRAIN(&sc->outq);
+	mtx_destroy(&sc->outq.ifq_mtx);
+	NG_NODE_UNREF(sc->node);
+	free(sc, M_NETGRAPH);
+
+	return (0);
+} /* ngh4_shutdown */
+
+static int
+ngh4_rcvmsg(node_p node, item_p item, hook_p lasthook)
+{
+	const sc_p sc = NG_NODE_PRIVATE(node);
+	struct ng_mesg *msg, *resp = NULL;
+	struct proc *p;
+	int error = 0;
+
+	NGI_GET_MSG(item, msg);
+	switch (msg->header.typecookie) {
+	case NGM_GENERIC_COOKIE:
+		switch (msg->header.cmd) {
+		case NGM_TEXT_STATUS:
+			NG_MKRESPONSE(resp, msg, NG_TEXTRESPONSE, M_NOWAIT);
+			if (resp == NULL)
+				ERROUT(ENOMEM);
+
+			snprintf(resp->data, NG_TEXTRESPONSE,
+			    "tty: %s\n"
+			    "debug: %d\n"
+			    "outq: [have:%zd bytes]\n"
+			    "stats: recv %u pkts/%u bytes, "
+			    "sent %u pkts/%u bytes, ierrs %u, oerrs %u",
+			    (sc->tp != NULL) ? tty_devname(sc->tp) : "-",
+			    sc->debug, sc->outqlen,
+			    sc->stat.pckts_recv, sc->stat.bytes_recv,
+			    sc->stat.pckts_sent, sc->stat.bytes_sent,
+			    sc->stat.ierrors, sc->stat.oerrors);
+			break;
+
+		default:
+			ERROUT(EINVAL);
+		}
+		break;
+
+	case NGM_H4_COOKIE:
+		switch (msg->header.cmd) {
+		case NGM_H4_NODE_SET_TTY:
+		    {
+			ng_h4_node_set_tty_ep *ep;
+
+			if (sc->tp != NULL)
+				ERROUT(EBUSY);
+			if (msg->header.arglen != sizeof(*ep))
+				ERROUT(EINVAL);
+			ep = (ng_h4_node_set_tty_ep *)msg->data;
+
+			p = pfind(ep->pid);
+			if (p == NULL || (p->p_flag & P_WEXIT))
+				ERROUT(ESRCH);
+			_PHOLD(p);
+			PROC_UNLOCK(p);
+			error = ttyhook_register(&sc->tp, p, ep->fd,
+			    &ngh4_hook, sc);
+			PRELE(p);
+			if (error != 0)
+				ERROUT(error);
+			break;
+		    }
+
+		case NGM_H4_NODE_SET_DEBUG:
+			if (msg->header.arglen != sizeof(ng_h4_node_debug_ep))
+				ERROUT(EINVAL);
+			sc->debug = *(ng_h4_node_debug_ep *)msg->data;
+			break;
+
+		case NGM_H4_NODE_GET_DEBUG:
+			NG_MKRESPONSE(resp, msg,
+			    sizeof(ng_h4_node_debug_ep), M_NOWAIT);
+			if (resp == NULL)
+				ERROUT(ENOMEM);
+			*(ng_h4_node_debug_ep *)resp->data = sc->debug;
+			break;
+
+		case NGM_H4_NODE_GET_STAT:
+			NG_MKRESPONSE(resp, msg,
+			    sizeof(ng_h4_node_stat_ep), M_NOWAIT);
+			if (resp == NULL)
+				ERROUT(ENOMEM);
+			*(ng_h4_node_stat_ep *)resp->data = sc->stat;
+			break;
+
+		case NGM_H4_NODE_RESET_STAT:
+			NGH4_STAT_RESET(sc);
+			break;
+
+		default:
+			ERROUT(EINVAL);
+		}
+		break;
+
+	default:
+		ERROUT(EINVAL);
+	}
+done:
+	NG_RESPOND_MSG(error, node, item, resp);
+	NG_FREE_MSG(msg);
+	return (error);
+} /* ngh4_rcvmsg */
+
+/*
+ * A frame from ng_hci, ready to go to the controller.  It already starts
+ * with the H4 indicator byte (see the file header comment) -- queue it
+ * whole and let ngh4_getc_inject() hand it to the tty a chunk at a time.
+ * Netgraph context.
+ */
+static int
+ngh4_rcvdata(hook_p hook, item_p item)
+{
+	const sc_p sc = NG_NODE_PRIVATE(NG_HOOK_NODE(hook));
+	struct tty *tp;
+	struct mbuf *m;
+	uint8_t type;
+
+	if (hook != sc->hook) {
+		NG_FREE_ITEM(item);
+		return (EINVAL);
+	}
+
+	NGI_GET_M(item, m);
+	NG_FREE_ITEM(item);
+
+	if (m->m_pkthdr.len < 1) {
+		NGH4_STAT_OERROR(sc);
+		NG_FREE_M(m);
+		return (EINVAL);
+	}
+
+	type = *mtod(m, uint8_t *);
+	switch (type) {
+	case NG_HCI_CMD_PKT:
+	case NG_HCI_ACL_DATA_PKT:
+	case NG_HCI_SCO_DATA_PKT:
+		break;
+	default:
+		NGH4_STAT_OERROR(sc);
+		NGH4_ERR(sc, "dropping outgoing frame with bad HCI packet "
+		    "type 0x%02x, pktlen=%d\n", type, m->m_pkthdr.len);
+		NG_FREE_M(m);
+		return (EINVAL);
+	}
+
+	tp = sc->tp;
+	if (tp == NULL) {
+		NGH4_STAT_OERROR(sc);
+		NG_FREE_M(m);
+		return (ENXIO);
+	}
+
+	NGH4LOCK(sc);
+	if (_IF_QFULL(&sc->outq)) {
+		NGH4_STAT_OERROR(sc);
+		NGH4UNLOCK(sc);
+		NG_FREE_M(m);
+		return (ENOBUFS);
+	}
+	_IF_ENQUEUE(&sc->outq, m);
+	sc->outqlen += m->m_pkthdr.len;
+	NGH4_STAT_PCKTS_SENT(sc);
+	NGH4_STAT_BYTES_SENT(sc, m->m_pkthdr.len);
+	NGH4UNLOCK(sc);
+
+	/* Wake the tty so it pulls the frame via ngh4_getc_inject() */
+	tty_lock(tp);
+	if (!tty_gone(tp))
+		ttydevsw_outwakeup(tp);
+	tty_unlock(tp);
+
+	return (0);
+} /* ngh4_rcvdata */
+
+/******************************************************************
+			TTYHOOK METHODS
+******************************************************************/
+
+/*
+ * Pull up to "len" bytes of outgoing H4 frame(s) into the tty's own
+ * output buffer.  Identical in shape to ng_tty.c's ngt_getc_inject();
+ * differs only in that our mbufs are ngh4_softc's, not ngt_softc's.
+ * tty context, tty locked.
+ */
+static size_t
+ngh4_getc_inject(struct tty *tp, void *buf, size_t len)
+{
+	sc_p sc = ttyhook_softc(tp);
+	size_t total = 0;
+	int length;
+
+	while (len) {
+		struct mbuf *m;
+
+		IF_DEQUEUE(&sc->outq, m);
+		if (m == NULL)
+			break;
+
+		while (m != NULL) {
+			length = min(m->m_len, len);
+			memcpy((char *)buf + total, mtod(m, char *), length);
+
+			m->m_data += length;
+			m->m_len -= length;
+			total += length;
+			len -= length;
+
+			if (m->m_len > 0)
+				break;	/* tty is full for now */
+			m = m_free(m);
+		}
+
+		if (m != NULL) {
+			IF_PREPEND(&sc->outq, m);
+			break;
+		}
+	}
+
+	NGH4LOCK(sc);
+	sc->outqlen -= total;
+	NGH4UNLOCK(sc);
+
+	return (total);
+} /* ngh4_getc_inject */
+
+static size_t
+ngh4_getc_poll(struct tty *tp)
+{
+	sc_p sc = ttyhook_softc(tp);
+
+	return (sc->outqlen);
+} /* ngh4_getc_poll */
+
+/*
+ * Optimized (bypass) receive: the tty driver hands us a whole buffer of
+ * newly-arrived bytes at once instead of one th_rint() call per byte.
+ * Just run each byte through the same reassembler ngh4_rint() uses.
+ * tty context, tty locked.
+ */
+static size_t
+ngh4_rint_bypass(struct tty *tp, const void *buf, size_t len)
+{
+	sc_p sc = ttyhook_softc(tp);
+	const uint8_t *p = buf;
+	size_t i;
+
+	tty_assert_locked(tp);
+
+	if (sc->hook == NULL)
+		return (0);
+
+	for (i = 0; i < len; i++)
+		ngh4_input(sc, p[i]);
+
+	return (len);
+} /* ngh4_rint_bypass */
+
+/*
+ * Non-bypass receive: one byte at a time, with line-error flags.
+ * tty context, tty locked.
+ */
+static int
+ngh4_rint(struct tty *tp, char c, int flags)
+{
+	sc_p sc = ttyhook_softc(tp);
+
+	tty_assert_locked(tp);
+
+	if (sc->hook == NULL)
+		return (0);
+
+	if (flags != 0) {
+		/* Framing error or overrun: the byte itself is suspect */
+		NGH4_STAT_IERROR(sc);
+		NGH4_WARN(sc, "line error %#x, resyncing\n", flags);
+		ngh4_rx_abort(sc);
+		return (0);
+	}
+
+	ngh4_input(sc, (uint8_t)c);
+	return (0);
+} /* ngh4_rint */
+
+static size_t
+ngh4_rint_poll(struct tty *tp)
+{
+
+	/* We can always accept input -- reassembly never blocks */
+	return (1);
+} /* ngh4_rint_poll */
