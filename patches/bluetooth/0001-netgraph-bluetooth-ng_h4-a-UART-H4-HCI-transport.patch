+
+#ifndef _NG_H4_VAR_H_
+#define	_NG_H4_VAR_H_	1
+
+/*
+ * Receive-side (tty -> HCI) reassembly state.  Entered/left only from tty
+ * context (ngh4_rint()/ngh4_rint_bypass()), which the tty layer already
+ * serializes for us (tty_assert_locked()) -- see the big comment in
+ * ng_h4.c.  No separate lock protects these fields.
+ */
+enum ngh4_rxstate {
+	NGH4_ST_W4_PKT_TYPE = 0,	/* waiting for the 1-byte H4 indicator */
+	NGH4_ST_W4_HDR,			/* accumulating the fixed per-type header */
+	NGH4_ST_W4_DATA			/* accumulating the payload */
+};
+
+/* Per-node private info */
+struct ngh4_softc {
+	struct tty	*tp;		/* Terminal device, or NULL if unbound */
+	node_p		node;		/* Netgraph node */
+	hook_p		hook;		/* The (single) Netgraph hook, "hook" */
+
+	struct ifqueue	outq;		/* HCI frames queued for the tty, each
+					   mbuf already starts with the H4
+					   packet indicator byte.  Its own
+					   ifq_mtx (initialized by us, like
+					   ng_tty.c does) is the only lock
+					   this node uses -- see NGH4LOCK(). */
+	size_t		outqlen;	/* bytes currently in outq */
+
+	/* RX reassembly -- tty context only, see ngh4_rxstate above */
+	enum ngh4_rxstate rx_state;
+	uint8_t		rx_type;	/* H4 indicator of the frame in progress */
+	uint8_t		rx_hdrlen;	/* expected header length for rx_type,
+					   including the indicator byte */
+	uint16_t	rx_need;	/* payload bytes still wanted (W4_DATA) */
+	struct mbuf	*rx_m;		/* frame being assembled (head) */
+	struct mbuf	*rx_last;	/* last mbuf in rx_m's chain */
+
+	u_int16_t	debug;		/* debug level, NG_H4_*_LEVEL */
+	ng_h4_node_stat_ep stat;	/* statistics, see ng_h4.h */
+};
+typedef struct ngh4_softc *sc_p;
+
+#define	NGH4LOCK(sc)		IF_LOCK(&(sc)->outq)
+#define	NGH4UNLOCK(sc)		IF_UNLOCK(&(sc)->outq)
+
+#define	NGH4_STAT_PCKTS_RECV(sc)	((sc)->stat.pckts_recv++)
+#define	NGH4_STAT_BYTES_RECV(sc, n)	((sc)->stat.bytes_recv += (n))
+#define	NGH4_STAT_PCKTS_SENT(sc)	((sc)->stat.pckts_sent++)
+#define	NGH4_STAT_BYTES_SENT(sc, n)	((sc)->stat.bytes_sent += (n))
+#define	NGH4_STAT_IERROR(sc)		((sc)->stat.ierrors++)
+#define	NGH4_STAT_OERROR(sc)		((sc)->stat.oerrors++)
+#define	NGH4_STAT_RESET(sc)		bzero(&(sc)->stat, sizeof((sc)->stat))
+
+/*
+ * Debug printf, gated on sc->debug like ubt(4)'s UBT_DEBUG().
+ * NG_NODE_NAME() never returns NULL (it is "" for an unnamed node), so
+ * there is no NULL case to guard against here.
+ */
+#define	NGH4_DEBUG(level, sc, fmt, ...)				\
+do {									\
+	if ((sc)->debug >= (level))					\
+		log(LOG_DEBUG, "ng_h4: %s: " fmt,			\
+		    (sc)->node != NULL ? NG_NODE_NAME((sc)->node) : "-", \
+		    ## __VA_ARGS__);					\
+} while (0)
+
+#define	NGH4_ALERT(...)		NGH4_DEBUG(NG_H4_ALERT_LEVEL, __VA_ARGS__)
+#define	NGH4_ERR(...)		NGH4_DEBUG(NG_H4_ERR_LEVEL, __VA_ARGS__)
+#define	NGH4_WARN(...)		NGH4_DEBUG(NG_H4_WARN_LEVEL, __VA_ARGS__)
+#define	NGH4_INFO(...)		NGH4_DEBUG(NG_H4_INFO_LEVEL, __VA_ARGS__)
+
+#endif /* ndef _NG_H4_VAR_H_ */
