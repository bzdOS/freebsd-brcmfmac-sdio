diff --git a/sys/compat/linuxkpi/common/include/linux/device.h b/sys/compat/linuxkpi/common/include/linux/device.h
index 291381092..fd21ba21c 100644
--- a/sys/compat/linuxkpi/common/include/linux/device.h
+++ b/sys/compat/linuxkpi/common/include/linux/device.h
@@ -132,6 +132,25 @@ struct device {
 	struct list_head devres_head;
 
 	struct dev_pm_info	power;
+
+	/*
+	 * KEEP LAST. Linux drivers reference dev->of_node; on FreeBSD it is
+	 * always NULL and nothing inside LinuxKPI reads it. It lives at the
+	 * end on purpose: placed anywhere earlier it shifts devres_lock and
+	 * devres_head, and every already-built LinuxKPI/drm-kmod module then
+	 * disagrees with the kernel about where those are. The failure is
+	 * brutal and names neither this field nor this file -- the module's
+	 * spin_lock_init() initialises one word while lkpi_devres_add() locks
+	 * another (which is really devres_head.next, self-pointing after
+	 * INIT_LIST_HEAD, so it reads as "held"), and the turnstile walk ends
+	 * in a misaligned ldaxr: "panic: Misaligned access from kernel space"
+	 * in _thread_lock(), ~5s into boot, on a random CPU. Cost a day to
+	 * find. Check with:
+	 *   llvm-objdump -d --disassemble-symbols=lkpi_devres_add <kernel>
+	 * Anything added to this struct belongs after this comment, not
+	 * before devres_lock.
+	 */
+	struct device_node *of_node;	/* DT node; always NULL on FreeBSD */
 };
 
 extern struct device linux_root_device;
@@ -732,6 +751,18 @@ devm_kmemdup_array(struct device *dev, const void *src, size_t n, size_t len,
 	return (devm_kmemdup(dev, src, size_mul(n, len), gfp));
 }
 
+
+static inline char *
+devm_kstrdup(struct device *dev, const char *s, gfp_t gfp)
+{
+	size_t len;
+
+	if (s == NULL)
+		return (NULL);
+	len = strlen(s) + 1;
+	return (devm_kmemdup(dev, s, len, gfp));
+}
+
 #define	devm_kzalloc(_dev, _size, _gfp)				\
     devm_kmalloc((_dev), (_size), (_gfp) | __GFP_ZERO)
 
diff --git a/sys/compat/linuxkpi/common/include/linux/mmc/sdio_func.h b/sys/compat/linuxkpi/common/include/linux/mmc/sdio_func.h
index 25670dd77..f989b369d 100644
--- a/sys/compat/linuxkpi/common/include/linux/mmc/sdio_func.h
+++ b/sys/compat/linuxkpi/common/include/linux/mmc/sdio_func.h
@@ -72,9 +72,30 @@ void sdio_unregister_driver(struct sdio_driver *);
  */
 extern int sdio_claim_host(struct sdio_func *);
 extern int sdio_release_host(struct sdio_func *);
-extern int sdio_enable_func(struct sdio_func *);
-extern int sdio_disable_func(struct sdio_func *);
-extern int sdio_set_block_size(struct sdio_func *, unsigned);
+/*
+ * These three names exist in BOTH APIs: Linux's (here) and FreeBSD's native
+ * dev/sdio (<dev/sdio/sdio_subr.h>), with different argument types.
+ *
+ * Do NOT define the LinuxKPI side under the bare name. linux_mmc_bsd.c has to
+ * call the NATIVE ones, and the kernel linker resolves a module's undefined
+ * reference against that module's own globals before the kernel's -- so a
+ * global `sdio_set_block_size` in linux_mmc.c captures the forwarder's call
+ * and the pair recurses, re-entering the Linux wrapper with a
+ * `struct sdio_func_bsd *` reinterpreted as a `struct sdio_func *`. That
+ * showed up as brcmfmac faulting on a garbage func (num in the millions,
+ * NULL bsd_func) during brcmf_sdiod_probe(); it cost a day to find, because
+ * everything about it looks like memory corruption rather than a name clash.
+ *
+ * Defining them as lkpi_* and mapping the Linux spelling with a macro keeps
+ * the colliding symbol out of the module entirely, so the forwarders bind to
+ * the kernel as intended.
+ */
+extern int lkpi_sdio_enable_func(struct sdio_func *);
+extern int lkpi_sdio_disable_func(struct sdio_func *);
+extern int lkpi_sdio_set_block_size(struct sdio_func *, unsigned);
+#define	sdio_enable_func(f)		lkpi_sdio_enable_func(f)
+#define	sdio_disable_func(f)		lkpi_sdio_disable_func(f)
+#define	sdio_set_block_size(f, b)	lkpi_sdio_set_block_size((f), (b))
 
 extern unsigned char sdio_readb(struct sdio_func *, unsigned int, int *);
 extern void sdio_writeb(struct sdio_func *, unsigned char, unsigned int, int *);
