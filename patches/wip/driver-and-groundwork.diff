diff --git a/sys/contrib/dev/broadcom/brcm80211/brcmfmac/sdio.c b/sys/contrib/dev/broadcom/brcm80211/brcmfmac/sdio.c
index 23e814427..190b708b1 100644
--- a/sys/contrib/dev/broadcom/brcm80211/brcmfmac/sdio.c
+++ b/sys/contrib/dev/broadcom/brcm80211/brcmfmac/sdio.c
@@ -4106,7 +4106,27 @@ brcmf_sdio_watchdog_thread(void *data)
 		if (kthread_should_stop())
 			break;
 		brcmf_sdiod_freezer_uncount(bus->sdiodev);
+#if defined(__FreeBSD__)
+		/*
+		 * LinuxKPI's send_sig(SIGTERM) does not make a kernel thread's
+		 * wait_for_completion_interruptible() return, so with the
+		 * watchdog timer stopped (idle bus) this thread never woke up
+		 * to notice kthread_should_stop() and brcmf_sdio_remove() hung
+		 * in kthread_stop() forever (kldunload stuck in D state).
+		 * Wake up on our own now and then; a timeout is treated like
+		 * a completion so the loop re-checks the stop flag first.
+		 */
+		wait = wait_for_completion_interruptible_timeout(
+		    &bus->watchdog_wait, msecs_to_jiffies(200));
+		if (wait == 0) {
+			/* Timed out: re-check kthread_should_stop() above. */
+			brcmf_sdiod_freezer_count(bus->sdiodev);
+			continue;
+		}
+		wait = (wait < 0) ? wait : 0;
+#else
 		wait = wait_for_completion_interruptible(&bus->watchdog_wait);
+#endif
 		brcmf_sdiod_freezer_count(bus->sdiodev);
 		brcmf_sdiod_try_freeze(bus->sdiodev);
 		if (!wait) {
diff --git a/sys/contrib/dev/broadcom/brcm80211/brcmutil/utils.c b/sys/contrib/dev/broadcom/brcm80211/brcmutil/utils.c
index 253a3c92c..7fd480a72 100644
--- a/sys/contrib/dev/broadcom/brcm80211/brcmutil/utils.c
+++ b/sys/contrib/dev/broadcom/brcm80211/brcmutil/utils.c
@@ -43,7 +43,16 @@ void brcmu_pkt_buf_free_skb(struct sk_buff *skb)
 	if (!skb)
 		return;
 
+#if defined(__FreeBSD__)
+	/*
+	 * LinuxKPI initialises a fresh skb with next == prev == skb (its
+	 * "not on any list" sentinel) rather than NULL, so the Linux check
+	 * would fire on every single free.  Only a real neighbour is a bug.
+	 */
+	WARN_ON(skb->next != NULL && skb->next != skb);
+#else
 	WARN_ON(skb->next);
+#endif
 	dev_kfree_skb_any(skb);
 }
 EXPORT_SYMBOL(brcmu_pkt_buf_free_skb);
