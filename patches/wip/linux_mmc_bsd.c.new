/*-
 * SPDX-License-Identifier: BSD-2-Clause
 *
 * linuxkpi SDIO bridge (planck-113): _bsd-suffixed forwarders over the
 * kernel-exported native dev/sdio helpers.
 *
 * linux_mmc.c renames the native API to <name>_bsd before including
 * <dev/sdio/sdio_subr.h> so the three names that genuinely collide with
 * the Linux API (sdio_enable_func/sdio_disable_func/sdio_set_block_size)
 * cannot self-recurse inside their own Linux-side implementations.  The
 * kernel exports the natives without the suffix, so this separate
 * translation unit -- which never sees the renames -- provides the
 * _bsd symbols as one-line forwarders.  Their own undefined references
 * resolve against the kernel (sdio_read_1 et al. are T in a MMCCAM
 * kernel with dev/sdio compiled in, e.g. BPI64WIFI).
 */

#include <sys/types.h>
#include <sys/systm.h>
#include <sys/bus.h>

#include <dev/sdio/sdio_subr.h>

/*
 * Prototypes mirroring <dev/sdio/sdio_subr.h> under the _bsd rename that
 * linux_mmc.c applies before including it (see the file comment above).
 */
uint8_t		sdio_read_1_bsd(struct sdio_func *, uint32_t, int *);
void		sdio_write_1_bsd(struct sdio_func *, uint32_t, uint8_t, int *);
uint32_t	sdio_read_4_bsd(struct sdio_func *, uint32_t, int *);
void		sdio_write_4_bsd(struct sdio_func *, uint32_t, uint32_t, int *);
uint8_t		sdio_f0_read_1_bsd(struct sdio_func *, uint32_t, int *);
void		sdio_f0_write_1_bsd(struct sdio_func *, uint32_t, uint8_t, int *);
int		sdio_enable_func_bsd(struct sdio_func *);
int		sdio_disable_func_bsd(struct sdio_func *);
int		sdio_set_block_size_bsd(struct sdio_func *, uint16_t);

uint8_t
sdio_read_1_bsd(struct sdio_func *f, uint32_t addr, int *err)
{
	return (sdio_read_1(f, addr, err));
}

void
sdio_write_1_bsd(struct sdio_func *f, uint32_t addr, uint8_t val, int *err)
{
	sdio_write_1(f, addr, val, err);
}

uint32_t
sdio_read_4_bsd(struct sdio_func *f, uint32_t addr, int *err)
{
	return (sdio_read_4(f, addr, err));
}

void
sdio_write_4_bsd(struct sdio_func *f, uint32_t addr, uint32_t val, int *err)
{
	sdio_write_4(f, addr, val, err);
}

uint8_t
sdio_f0_read_1_bsd(struct sdio_func *f, uint32_t addr, int *err)
{
	return (sdio_f0_read_1(f, addr, err));
}

void
sdio_f0_write_1_bsd(struct sdio_func *f, uint32_t addr, uint8_t val, int *err)
{
	sdio_f0_write_1(f, addr, val, err);
}

int
sdio_enable_func_bsd(struct sdio_func *f)
{
	return (sdio_enable_func(f));
}

int
sdio_disable_func_bsd(struct sdio_func *f)
{
	return (sdio_disable_func(f));
}

int
sdio_set_block_size_bsd(struct sdio_func *f, uint16_t bs)
{
	return (sdio_set_block_size(f, bs));
}
