@@ -1853,7 +1853,20 @@ static __inline void
 cfg80211_connect_done(struct net_device *ndev,
     struct cfg80211_connect_resp_params *conn_params, gfp_t gfp)
 {
-	TODO();
+	/*
+	 * Real nl80211 hands this to a netlink socket for wpa_supplicant to
+	 * read; we have neither, so at minimum surface the result where it
+	 * can be observed (dmesg) and reflect it in the one piece of kernel
+	 * state anything else can see: carrier state on the ifnet.
+	 */
+	if (conn_params == NULL)
+		return;
+	printf("cfg80211_connect_done: %s status=%d\n", ndev->name,
+	    conn_params->status);
+	if (conn_params->status == 0)
+		netif_carrier_on(ndev);
+	else
+		netif_carrier_off(ndev);
 }
 
